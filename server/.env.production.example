NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-domain.example
MONGODB_URI=mongodb://workflow_user:replace_me@mongo:27017/workflow?authSource=admin
JWT_ACCESS_SECRET=replace_with_a_cryptographically_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12
TRUST_PROXY=true
API_RATE_LIMIT=600

# Optional transactional email delivery via Resend
RESEND_API_KEY=
EMAIL_FROM=WorkFlow <notifications@example.com>
