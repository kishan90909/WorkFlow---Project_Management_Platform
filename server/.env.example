NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27018/workflow
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12
ADMIN_NAME=Workflow Admin
ADMIN_EMAIL=admin@workflow.local
ADMIN_PASSWORD=change123
TRUST_PROXY=false
API_RATE_LIMIT=600

# Optional transactional email delivery via Resend
RESEND_API_KEY=
EMAIL_FROM=WorkFlow <notifications@example.com>
